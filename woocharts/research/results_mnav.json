 "meta": {
  "mnav_ev": "(mcap + debt + pref - cash)/(btc_held*btc_px); mcap uses basic shares (10-Q/10-K cover anchor + 8-K ATM sales after anchor). Converts treated as debt only (no share dilution) to avoid double counting.",
  "mnav_eq": "mcap/(btc_nav - debt - pref + cash); undefined when equity NAV <= 0",
  "point_in_time": "each input used only after its SEC acceptance time and before the day's US close (20/21 UTC)",
  "btc_px": "checkonchain hourly BTC price one hour before US close",
  "entry_signal": "BTC (Bitstamp) daily low <= 1.05*CVDD(t-1); buy at MSTR close if first hourly price below threshold came before US close, else next trading day close",
  "limits": [
   "2 cycles only (2022, 2025-26 ongoing)",
   "debt = XBRL LongTermDebt carrying value (2020-21 converts carried below face)",
   "pref = quarterly liquidation preference from 10-Q/XBRL; intra-quarter preferred issuance/repurchase not tracked; FY2025 10-K pref not parsed (2026-02-19..2026-05-06 uses Q3 2025 value)",
   "cash = XBRL cash & equivalents (includes USD reserve from Dec 2025)",
   "shares exclude options/RSUs/convert shares"
  ]
 }
